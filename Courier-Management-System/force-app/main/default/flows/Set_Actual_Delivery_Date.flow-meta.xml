<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
  <apiVersion>62.0</apiVersion>
  <description>Fills Actual Delivery Date the first time a shipment becomes Delivered.</description>
  <environments>Default</environments>
  <interviewLabel>Set Actual Delivery Date {!$Flow.CurrentDateTime}</interviewLabel>
  <label>Set Actual Delivery Date</label>
  <processMetadataValues><name>BuilderType</name><value><stringValue>LightningFlowBuilder</stringValue></value></processMetadataValues>
  <processType>AutoLaunchedFlow</processType>
  <assignments>
    <name>Stamp_Date</name>
    <label>Stamp Date</label>
    <locationX>50</locationX>
    <locationY>180</locationY>
    <assignmentItems><assignToReference>$Record.Actual_Delivery_Date__c</assignToReference><operator>Assign</operator><value><elementReference>$Flow.CurrentDate</elementReference></value></assignmentItems>
  </assignments>
  <start>
    <locationX>50</locationX>
    <locationY>0</locationY>
    <connector><targetReference>Stamp_Date</targetReference></connector>
    <filterLogic>and</filterLogic>
    <filters><field>Status__c</field><operator>EqualTo</operator><value><stringValue>Delivered</stringValue></value></filters>
    <filters><field>Actual_Delivery_Date__c</field><operator>IsNull</operator><value><booleanValue>true</booleanValue></value></filters>
    <object>Shipment__c</object>
    <recordTriggerType>CreateAndUpdate</recordTriggerType>
    <triggerType>RecordBeforeSave</triggerType>
  </start>
  <status>Active</status>
</Flow>
