<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
  <fullName>Update_Time_Not_Future</fullName>
  <active>true</active>
  <errorConditionFormula>Update_Time__c &gt; NOW() + 0.003</errorConditionFormula>
  <errorDisplayField>Update_Time__c</errorDisplayField>
  <errorMessage>Update time cannot be in the future.</errorMessage>
</ValidationRule>
