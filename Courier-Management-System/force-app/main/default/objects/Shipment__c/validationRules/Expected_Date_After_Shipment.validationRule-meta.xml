<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
  <fullName>Expected_Date_After_Shipment</fullName>
  <active>true</active>
  <errorConditionFormula>AND(NOT(ISBLANK(Shipment_Date__c)), NOT(ISBLANK(Expected_Delivery_Date__c)), Expected_Delivery_Date__c &lt; Shipment_Date__c)</errorConditionFormula>
  <errorDisplayField>Expected_Delivery_Date__c</errorDisplayField>
  <errorMessage>Expected delivery date cannot be before the shipment date.</errorMessage>
</ValidationRule>
