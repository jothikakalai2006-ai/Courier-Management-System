<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
  <fullName>Shipping_Cost_Must_Be_Positive</fullName>
  <active>true</active>
  <errorConditionFormula>Shipping_Cost__c &lt;= 0</errorConditionFormula>
  <errorDisplayField>Shipping_Cost__c</errorDisplayField>
  <errorMessage>Shipping cost must be greater than zero.</errorMessage>
</ValidationRule>
