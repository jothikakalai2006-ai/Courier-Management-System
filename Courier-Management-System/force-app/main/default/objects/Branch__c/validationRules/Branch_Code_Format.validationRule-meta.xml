<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
  <fullName>Branch_Code_Format</fullName>
  <active>true</active>
  <errorConditionFormula>OR(ISBLANK(Branch_Code__c), NOT(REGEX(Branch_Code__c, "[A-Z]{3}[0-9]{3}")))</errorConditionFormula>
  <errorDisplayField>Branch_Code__c</errorDisplayField>
  <errorMessage>Branch code must be 3 capital letters followed by 3 digits (e.g. CHN001).</errorMessage>
</ValidationRule>
